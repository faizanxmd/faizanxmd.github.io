{
  "title": "RevisionRequest.v1",
  "type": "object",
  "required": ["task_id", "round", "verdict", "issues"],
  "properties": {
    "task_id": { "type": "string" },
    "round": { "type": "integer" },
    "verdict": { "type": "string", "enum": ["revise"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description", "required_fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "description": { "type": "string" },
          "required_fix": { "type": "string" }
        }
      }
    },
    "unchanged_requirements": { "type": "string" }
  }
}
